use flake ~/dotfiles/templates/rails-7.1-react
PATH_add "$HOME/dotfiles/templates/rails-7.1-react/bin"

export GEM_HOME="$PWD/.gems"
export PATH="$GEM_HOME/bin:$PATH"
export PGDATA="$PWD/.pgdata"
export LANG=en_US.UTF-8

# Bootstrap Rails 7.1 into .gems so `rails new .` works right away.
# Once a Gemfile exists, Bundler and Gemfile.lock decide the version instead.
RAILS_VERSION="~> 7.1.0"
if [ ! -f Gemfile ] && ! gem list -i rails -v "$RAILS_VERSION" >/dev/null 2>&1; then
  echo "Installing Rails $RAILS_VERSION into .gems (first time only)..."
  gem install rails -v "$RAILS_VERSION" --no-document
fi
